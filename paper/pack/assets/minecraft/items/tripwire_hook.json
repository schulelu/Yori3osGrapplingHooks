{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:custom_model_data",
    "index": 0,
    "cases": [
      {
        "when": "yo_hooks:copper_hook_head",
        "model": {
          "type": "minecraft:model",
          "model": "yo_hooks:item/copper_hook_head"
        }
      },
      {
        "when": "yo_hooks:iron_hook_head",
        "model": {
          "type": "minecraft:model",
          "model": "yo_hooks:item/iron_hook_head"
        }
      },
      {
        "when": "yo_hooks:gold_hook_head",
        "model": {
          "type": "minecraft:model",
          "model": "yo_hooks:item/gold_hook_head"
        }
      },
      {
        "when": "yo_hooks:diamond_hook_head",
        "model": {
          "type": "minecraft:model",
          "model": "yo_hooks:item/diamond_hook_head"
        }
      },
      {
        "when": "yo_hooks:netherite_hook_head",
        "model": {
          "type": "minecraft:model",
          "model": "yo_hooks:item/netherite_hook_head"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "minecraft:item/tripwire_hook"
    }
  }
}
